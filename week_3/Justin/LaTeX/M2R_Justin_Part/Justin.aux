\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Heston MC price as a function of the number of Euler--Maruyama time steps $n$, with $M = 2\times 10^5$ paths fixed. Parameters: $S_0 = K = 100$, $T=1$, $r=0.05$, $\kappa =2$, $\theta =0.04$, $\omega =0.3$, $\rho =-0.7$, $V_0=0.04$. The dashed line is the semi-analytic Heston price (10.3942).\relax }}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:heston_timestep}{{5}{10}{Heston MC price as a function of the number of Euler--Maruyama time steps $n$, with $M = 2\times 10^5$ paths fixed. Parameters: $S_0 = K = 100$, $T=1$, $r=0.05$, $\kappa =2$, $\theta =0.04$, $\omega =0.3$, $\rho =-0.7$, $V_0=0.04$. The dashed line is the semi-analytic Heston price (10.3942).\relax }{figure.caption.7}{}}
